---
// Single source of content for the site. Facts mirror the verified portfolio notes:
// no employer, operator or customer names beyond what is already public.
//
// Look: an ink-drawn game world on Huggian's palette and type. Structures borrowed from
// games in general (HUD, achievements, quest log, crafting grid, inventory), all original
// art. Motion is CSS/SVG only, no JavaScript, and switches off under prefers-reduced-motion.
const email = 'onoriagaariel@gmail.com';

const achievements = [
  { icon: 'flag', title: 'Solo run', text: 'Founded, built and operate a production SaaS alone.' },
  { icon: 'shield', title: 'Passed the audit', text: 'Shipped gaming products that passed GLI certification.' },
  { icon: 'crate', title: 'Seven crates', text: 'Published a seven-crate Rust workspace on crates.io.' },
  { icon: 'star', title: 'Fast climb', text: 'Trainee to lead of a seven-person team in under two years.' },
];

const mainQuest = {
  title: 'Ez-Stock',
  kind: 'Main quest · multi-tenant commerce SaaS · founder, sole engineer',
  summary: 'Stock, point-of-sale and electronic invoicing for small and mid-size retailers. In production.',
  points: [
    'Rust backend (Axum, SQLx, Tokio) on PostgreSQL, organised as about 40 bounded contexts with 440+ migrations.',
    'Offline-capable POS that syncs when the connection returns.',
    'Transactional outbox with idempotency keys, payment-provider integration and government tax invoicing.',
    'Property-based and mutation testing; rollouts follow runbooks with precheck and rollback SQL.',
  ],
  stack: ['Rust', 'Axum', 'PostgreSQL', 'SolidJS', 'TypeScript'],
  link: { href: 'https://ez-stock.huggian.com', label: 'ez-stock.huggian.com' },
};

const crafting = {
  title: 'Four services into one',
  kind: 'Crafting · service consolidation in Rust',
  summary:
    'Replaced four separately deployed services with a single Rust API and worker, migrated live in phases with each old service retired in turn.',
  inputs: ['images', 'catalog', 'recs', 'AI'],
  output: 'one Rust API + worker',
  points: [
    'Scoped API keys with quotas and usage-based billing.',
    'A telemetry ingestion platform built as six crates.',
    'Documented performance baseline before and after.',
  ],
  stack: ['Rust', 'PostgreSQL', 'Redis'],
};

const sideQuests = [
  {
    title: 'Billing, fiscal and identity platform',
    kind: 'Side quest · platform core in TypeScript',
    summary:
      'The shared platform behind the products: subscriptions, payment processing, fiscal invoicing, identity, event delivery and an admin console.',
    points: ['27 bounded contexts, tested against a real PostgreSQL instance.', 'Tag-triggered CI builds and deploys.'],
    stack: ['TypeScript', 'Bun', 'Hono', 'Drizzle', 'PostgreSQL'],
  },
  {
    title: 'Production infrastructure, run solo',
    kind: 'Side quest · deploys, rollback and operations',
    summary: 'Everything above runs on infrastructure I built and operate alone.',
    points: [
      'CI deploy, rollback and scheduled deploys, with health-gated rollouts and a deploy-window guard.',
      'Scale-to-zero for idle services, self-hosted secrets management and monitoring.',
    ],
    stack: ['Docker', 'nginx', 'GitHub Actions', 'systemd'],
  },
];

const experience = [
  {
    role: 'Core engineer, real-money gaming platform',
    when: 'Aug 2024 – present',
    status: 'Active',
    points: [
      'Core engineer on a multi-tenant gaming platform (remote game server and back office): a Go and TypeScript monorepo on AWS serverless. About 3,700 commits, roughly 38% of the codebase.',
      'Designed and maintain five shared TypeScript libraries and a game template that the studio’s game teams build on.',
      'Terraform across Lambda, API Gateway, DynamoDB, Aurora, ECS, CloudFront and IoT Core, plus the GitHub Actions pipelines.',
      'Co-developed RNG and game-math services with Monte Carlo simulation tooling. The products passed GLI certification.',
      'Wrote the team’s internal tooling: a Rust terminal UI for multi-environment deploy status and a Go service for game scaffolding.',
    ],
  },
  {
    role: 'Founder and engineer, Huggian',
    when: 'Alongside',
    status: 'Active',
    points: ['Built and run the commerce, billing and infrastructure products described above, end to end.'],
  },
  {
    role: 'Trainee to team lead, PicallEx',
    when: 'Earlier',
    status: 'Completed',
    points: ['Joined as a trainee and was leading a team of seven engineers in under two years.'],
  },
  {
    role: 'Freelance engineer',
    when: 'Earlier',
    status: 'Completed',
    points: [
      'Independent client projects, including a WordPress-to-static migration that cut a client’s hosting cost by 90% and raised Lighthouse from 52 to 98.',
    ],
  },
];

const openSource = [
  {
    name: 'lazyfetch',
    href: 'https://github.com/arielonoriaga/lazyfetch',
    what: 'Terminal HTTP client: collections, environments, Postman import, vim keys. Published on crates.io as a seven-crate hexagonal workspace with an IO-free core enforced in CI.',
    lang: 'Rust',
  },
  {
    name: 'entropy-hunter',
    href: 'https://github.com/arielonoriaga/entropy-hunter',
    what: 'Deterministic code-health analyzer for Rust and TypeScript: complexity, coupling, churn and duplication, with a regression gate for CI.',
    lang: 'TypeScript',
  },
  {
    name: 'claude-harness',
    href: 'https://github.com/arielonoriaga/claude-harness',
    what: 'Safety and self-improvement harness for AI coding agents: a guardrail hook, shared journal, test agent and review queue.',
    lang: 'Rust · Shell',
  },
  {
    name: 'lazywifi',
    href: 'https://github.com/arielonoriaga/lazywifi',
    what: 'Terminal UI for NetworkManager: wifi, ethernet, VPN and QR sharing.',
    lang: 'Rust',
  },
];

const hotbar = ['Rust', 'TypeScript', 'Go', 'SQL', 'Python', 'Postgres', 'AWS', 'Terraform', 'Docker'];

const skills = [
  ['Backend', 'Axum, SQLx, Tokio, Hono, Drizzle · PostgreSQL, DynamoDB, Redis · GraphQL, MQTT, queues, outbox and idempotency patterns'],
  ['Frontend', 'SolidJS, Svelte, Vue, Astro · Phaser, PixiJS · PWA and offline sync'],
  ['Cloud and ops', 'AWS (Lambda, API Gateway, DynamoDB, Aurora, ECS, CloudFront, IoT Core, SQS/SNS) · Terraform · Docker · GitHub Actions'],
  ['Practices', 'Domain-driven and hexagonal design · property and mutation testing · AI-agent workflows with review gates'],
];

const description =
  'Ariel Onoriaga — senior Rust and TypeScript engineer. Backend, payments and commerce systems. Available for contract work with US teams.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Ariel Onoriaga — Senior Rust / TypeScript engineer</title>
    <meta name="description" content={description} />
    <meta property="og:title" content="Ariel Onoriaga — Senior Rust / TypeScript engineer" />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://arielonoriaga.huggian.com/" />
    <link rel="canonical" href="https://arielonoriaga.huggian.com/" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#dcecf9" />
    <meta name="color-scheme" content="light" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Chango&family=Figtree:wght@400;500;700&family=Pixelify+Sans:wght@500;700&family=Syne:wght@700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <!-- Reusable pixel icons, drawn on an 8×8 grid. -->
    <svg class="defs" width="0" height="0" aria-hidden="true" focusable="false">
      <symbol id="i-flag" viewBox="0 0 8 8"><path d="M1 0h1v8H1z" fill="#16233b" /><path d="M2 1h5v1H6v1h1v1H2z" fill="#d2453a" /></symbol>
      <symbol id="i-shield" viewBox="0 0 8 8"><path d="M1 1h6v3H6v2H5v1H3V6H2V4H1z" fill="#1466c4" /><path d="M3 3h1v1h1V2h1v2H5v1H4V4H3z" fill="#fff" /></symbol>
      <symbol id="i-crate" viewBox="0 0 8 8"><path d="M0 1h8v6H0z" fill="#b9793f" /><path d="M0 1h8v1H0zM0 6h8v1H0zM0 1h1v6H0zM7 1h1v6H7z" fill="#6f4423" /><path d="M2 2h1v1h1v1h1v1h1v1H5V5H4V4H3V3H2z" fill="#6f4423" /></symbol>
      <symbol id="i-star" viewBox="0 0 8 8"><path d="M3 0h2v2h3v2H6v1h1v3H5V7H3v1H1V5h1V4H0V2h3z" fill="#f0b63a" /><path d="M3 2h2v1H3z" fill="#fff3c4" /></symbol>
    </svg>

    <a class="skip" href="#work">Skip to work</a>

    <header class="world">
      <div class="hud">
        <a class="hud-name" href="#top" aria-label="Ariel Onoriaga, top of page">
          <svg viewBox="0 0 64 64" aria-hidden="true"><use href="/favicon.svg#crab" /></svg>
          <span>Ariel Onoriaga</span>
        </a>
        <div class="hud-level" aria-label="Seven years of experience">
          <span>LVL 7</span>
          <span class="xp"><i></i></span>
          <span class="hud-class">Engineer</span>
        </div>
        <p class="hud-status"><i aria-hidden="true"></i>Taking contract quests · 20 h/week · UTC−3</p>
      </div>

      <div class="sky" aria-hidden="true">
        <div class="sun"><span></span></div>
        <svg class="cloud c1" viewBox="0 0 16 6"><path d="M4 0h6v1h3v1h2v2h1v2H0V4h1V2h2V1h1z" /></svg>
        <svg class="cloud c2" viewBox="0 0 16 6"><path d="M4 0h6v1h3v1h2v2h1v2H0V4h1V2h2V1h1z" /></svg>
        <svg class="cloud c3" viewBox="0 0 16 6"><path d="M4 0h6v1h3v1h2v2h1v2H0V4h1V2h2V1h1z" /></svg>
      </div>

      <div class="stagewrap" id="top">
        <div class="intro">
          <p class="eyebrow">Player one · senior Rust &amp; TypeScript engineer</p>
          <h1><span>Ariel</span> <span>Onoriaga</span></h1>
          <p class="lede">
            I build and run the systems where mistakes cost money: payments, billing, commerce,
            and the infrastructure under them.
          </p>
          <p class="proof">
            Seven years in. One production SaaS built and operated alone, and gaming products that
            passed certification.
          </p>
          <nav class="cta" aria-label="Contact">
            <a class="btn primary" href={`mailto:${email}`}>Email me</a>
            <a class="btn" href="https://www.linkedin.com/in/arielonoriaga/">LinkedIn</a>
            <a class="btn" href="https://github.com/arielonoriaga">GitHub</a>
          </nav>
        </div>

        <div class="stage">
          <!-- A nod to the Huggian product graph: the things I built, and room for yours. -->
          <svg class="constellation" viewBox="0 0 340 210" role="img" aria-label="Products I built: Huggian, Ez-Stock, ez-catalog, ez-contador. One empty node labelled your project.">
            <g class="links">
              <path d="M170 104 L78 48" /><path d="M170 104 L262 60" /><path d="M78 48 L262 60" /><path d="M78 48 L74 158" />
              <path class="open" d="M170 104 L268 166" />
            </g>
            <g class="node n0"><circle cx="170" cy="104" r="11" /><text x="170" y="134">Huggian</text></g>
            <g class="node n1"><circle cx="78" cy="48" r="9" /><text x="78" y="28">Ez-Stock</text></g>
            <g class="node n2"><circle cx="262" cy="60" r="8" /><text x="262" y="40">ez-catalog</text></g>
            <g class="node n3"><circle cx="74" cy="158" r="7" /><text x="74" y="184">ez-contador</text></g>
            <g class="node n4"><circle cx="268" cy="166" r="9" /><text x="268" y="194">your project?</text></g>
          </svg>

          <div class="walker">
            <p class="bubble" aria-hidden="true"><span>hi!</span><span>cargo build ✓</span><span>tests green</span></p>
            <svg class="crab" viewBox="0 0 260 240" role="img" aria-label="A cartoon crab walking sideways and waving">
              <ellipse class="crab-shadow" cx="130" cy="224" rx="78" ry="9" />
              <g class="crab-hop"><g class="crab-all">
                <g class="legs legs-l"><path d="M82 168 Q52 176 44 208" /><path d="M94 176 Q70 190 68 214" /><path d="M108 180 Q94 196 96 216" /></g>
                <g class="legs legs-r"><path d="M178 168 Q208 176 216 208" /><path d="M166 176 Q190 190 192 214" /><path d="M152 180 Q166 196 164 216" /></g>
                <g class="arm arm-l">
                  <path class="hose" d="M70 138 Q34 128 34 92" />
                  <path class="claw-top" d="M34 92 Q10 86 12 60 Q22 40 44 46 Q38 62 34 92 Z" />
                  <path class="claw-bot" d="M34 92 Q58 88 60 64 Q54 50 44 46 Q46 66 34 92 Z" />
                </g>
                <g class="arm arm-r">
                  <path class="hose" d="M190 138 Q226 128 226 92" />
                  <path class="claw-top" d="M226 92 Q250 86 248 60 Q238 40 216 46 Q222 62 226 92 Z" />
                  <path class="claw-bot" d="M226 92 Q202 88 200 64 Q206 50 216 46 Q214 66 226 92 Z" />
                </g>
                <path class="stalk" d="M108 104 Q104 86 106 70" /><path class="stalk" d="M152 104 Q156 86 154 70" />
                <ellipse class="shell" cx="130" cy="142" rx="68" ry="46" />
                <path class="shine" d="M84 124 Q98 104 124 102" />
                <g class="eye"><ellipse class="white" cx="106" cy="58" rx="17" ry="24" /><g class="look"><ellipse class="pupil" cx="108" cy="62" rx="8" ry="13" /><path class="glint" d="M108 62 L119 53 L119 65 Z" /></g></g>
                <g class="eye"><ellipse class="white" cx="154" cy="58" rx="17" ry="24" /><g class="look"><ellipse class="pupil" cx="156" cy="62" rx="8" ry="13" /><path class="glint" d="M156 62 L167 53 L167 65 Z" /></g></g>
                <path class="mouth" d="M100 146 Q130 182 160 146 Q130 156 100 146 Z" />
                <path class="tongue" d="M118 162 Q130 172 142 162 Q130 158 118 162 Z" />
                <circle class="cheek" cx="92" cy="150" r="7" /><circle class="cheek" cx="168" cy="150" r="7" />
              </g></g>
            </svg>
          </div>
        </div>
      </div>

      <div class="ground" aria-hidden="true"><span class="sign">work ↓</span></div>
    </header>

    <main>
      <section class="achievements" aria-label="Achievements">
        <h2 class="tag">Achievements unlocked</h2>
        <ul>
          {achievements.map((a) => (
            <li>
              <svg class="pix" viewBox="0 0 8 8" aria-hidden="true"><use href={`#i-${a.icon}`} /></svg>
              <div><strong>{a.title}</strong><span>{a.text}</span></div>
            </li>
          ))}
        </ul>
      </section>

      <section id="about" class="about">
        <h2 class="tag">How I play</h2>
        <p class="big">
          I’m most useful where correctness matters and one person has to hold the whole picture:
          <mark>money movement</mark>, multi-tenant data, integrations with systems that don’t
          forgive retries.
        </p>
        <p>
          I work AI-augmented. Agents write a lot of the code; I own the architecture, the review
          and the test gates, which is how one engineer can responsibly run this much surface area.
        </p>
      </section>

      <section id="work">
        <h2 class="tag">Quest log</h2>

        <article class="quest main">
          <div>
            <p class="kind">{mainQuest.kind}</p>
            <h3>{mainQuest.title}</h3>
            <p class="sum">{mainQuest.summary}</p>
            <p class="stack">{mainQuest.stack.map((s) => <span>{s}</span>)}</p>
            <p class="more"><a href={mainQuest.link.href}>{mainQuest.link.label} →</a></p>
          </div>
          <ul>{mainQuest.points.map((p) => <li>{p}</li>)}</ul>
        </article>

        <article class="quest craft">
          <div class="bench" aria-hidden="true">
            <div class="grid">{crafting.inputs.map((i) => <span class="slot">{i}</span>)}</div>
            <span class="arrow">→</span>
            <span class="slot out">{crafting.output}</span>
          </div>
          <div>
            <p class="kind">{crafting.kind}</p>
            <h3>{crafting.title}</h3>
            <p class="sum">{crafting.summary}</p>
            <ul>{crafting.points.map((p) => <li>{p}</li>)}</ul>
            <p class="stack">{crafting.stack.map((s) => <span>{s}</span>)}</p>
          </div>
        </article>

        <div class="sides">
          {sideQuests.map((q) => (
            <article class="quest side">
              <p class="kind">{q.kind}</p>
              <h3>{q.title}</h3>
              <p class="sum">{q.summary}</p>
              <ul>{q.points.map((p) => <li>{p}</li>)}</ul>
              <p class="stack">{q.stack.map((s) => <span>{s}</span>)}</p>
            </article>
          ))}
        </div>
      </section>

      <section id="experience">
        <h2 class="tag">Campaign history</h2>
        <ol class="campaign">
          {experience.map((e) => (
            <li>
              <p class="when">
                <span class={`status ${e.status.toLowerCase()}`}>{e.status}</span>
                {e.when}
              </p>
              <div>
                <h3>{e.role}</h3>
                <ul>{e.points.map((p) => <li>{p}</li>)}</ul>
              </div>
            </li>
          ))}
        </ol>
      </section>

      <section id="open-source">
        <h2 class="tag">Open-source drops</h2>
        <p class="note">Most of my product code is private. These are the projects you can read.</p>
        <ul class="oss">
          {openSource.map((o) => (
            <li>
              <a href={o.href}>{o.name}</a>
              <span class="lang">{o.lang}</span>
              <p>{o.what}</p>
            </li>
          ))}
        </ul>
      </section>

      <section id="skills">
        <h2 class="tag">Inventory</h2>
        <ul class="hotbar" aria-label="Core tools">
          {hotbar.map((h, i) => <li><small>{i + 1}</small>{h}</li>)}
        </ul>
        <dl class="skills">
          {skills.map(([k, v]) => (
            <>
              <dt>{k}</dt>
              <dd>{v}</dd>
            </>
          ))}
        </dl>
      </section>

      <section id="contact" class="coop">
        <div>
          <p class="tag">Player two wanted</p>
          <h2>Got a quest that needs a senior engineer?</h2>
          <p>
            Send three lines: what you’re building, what’s stuck, and your timeline. I reply within
            two days with a yes, a no, or a time for a 20-minute call.
          </p>
          <p class="cta">
            <a class="btn primary" href={`mailto:${email}`}>{email}</a>
            <a class="btn" href="https://www.linkedin.com/in/arielonoriaga/">LinkedIn</a>
          </p>
        </div>
      </section>
    </main>

    <footer>
      <p>
        © {new Date().getFullYear()} Ariel Onoriaga ·
        <a href="https://github.com/arielonoriaga">GitHub</a> ·
        <a href="https://www.linkedin.com/in/arielonoriaga/">LinkedIn</a> ·
        <a href="https://crates.io/users/arielonoriaga">crates.io</a>
      </p>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    /* Huggian's cool paper and blue accent, plus the product colours from its graph. */
    --void: oklch(98% 0.006 240);
    --deep: oklch(95.5% 0.012 240);
    --sky: oklch(91% 0.045 235);
    --ink: oklch(24% 0.045 255);
    --ink-soft: oklch(42% 0.04 250);
    --blue: oklch(50% 0.2 235);
    --blue-deep: oklch(40% 0.18 240);
    --orange: oklch(68% 0.17 50);
    --teal: oklch(64% 0.12 185);
    --red: oklch(60% 0.19 28);
    --gold: oklch(80% 0.15 85);
    --grass: oklch(66% 0.15 150);
    --grass-dark: oklch(52% 0.13 152);
    --dirt: oklch(55% 0.08 60);
    --dirt-dark: oklch(44% 0.07 55);
    --display: 'Syne', 'Avenir Next', 'Segoe UI', sans-serif;
    --title: 'Chango', 'Cooper Black', 'Arial Black', serif;
    --pixel: 'Pixelify Sans', ui-monospace, 'Courier New', monospace;
    --body: 'Figtree', -apple-system, 'Segoe UI', 'Helvetica Neue', Arial, 'Liberation Sans', sans-serif;
    --px: 4px; /* one "pixel" of the world art */
    --ease: cubic-bezier(0.16, 1, 0.3, 1);
  }

  *, *::before, *::after { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; scroll-behavior: smooth; }
  body { margin: 0; background: var(--void); color: var(--ink); font-family: var(--body); font-size: 1.0625rem; line-height: 1.6; overflow-x: hidden; }
  .defs { position: absolute; }
  .skip { position: absolute; left: -999px; z-index: 30; }
  .skip:focus { left: 1rem; top: 1rem; background: var(--void); padding: 0.5rem 0.75rem; border: 3px solid var(--ink); }
  a { color: var(--blue-deep); text-underline-offset: 0.2em; text-decoration-thickness: 2px; }
  a:focus-visible, .btn:focus-visible { outline: 3px solid var(--blue); outline-offset: 3px; }
  h1, h2, h3 { margin: 0; line-height: 1.08; text-wrap: balance; }
  p { margin: 0 0 1rem; }
  ul { margin: 0 0 1rem; padding-left: 1.15rem; }
  li { margin-bottom: 0.4rem; }
  mark { background: linear-gradient(transparent 62%, var(--gold) 62% 92%, transparent 92%); color: inherit; }

  /* ── World: sky, HUD, stage and ground ── */
  .world { position: relative; isolation: isolate; overflow: hidden; background: linear-gradient(var(--sky), var(--deep) 70%, var(--void)); }
  .hud { position: relative; z-index: 3; display: flex; flex-wrap: wrap; align-items: center; gap: 0.6rem 1.5rem; max-width: 70rem; margin: 0 auto; padding: 1rem 1.25rem;
    font-family: var(--pixel); font-size: 0.95rem; }
  .hud-name { display: flex; align-items: center; gap: 0.55rem; color: var(--ink); text-decoration: none; font-family: var(--display); font-weight: 800; font-size: 0.95rem; letter-spacing: 0.14em; text-transform: uppercase; }
  .hud-name svg { width: 1.9rem; height: 1.9rem; }
  .hud-level { display: flex; align-items: center; gap: 0.55rem; margin-left: auto; }
  .xp { width: 6.5rem; height: 0.8rem; border: 2px solid var(--ink); background: var(--void); padding: 1px; }
  .xp i { display: block; height: 100%; width: 78%; background: repeating-linear-gradient(90deg, var(--grass) 0 6px, var(--grass-dark) 6px 8px); }
  .hud-class { color: var(--ink-soft); }
  .hud-status { margin: 0; display: flex; align-items: center; gap: 0.5rem; }
  .hud-status i { width: 0.7rem; height: 0.7rem; background: var(--grass); border: 2px solid var(--ink); }

  .sky { position: absolute; inset: 0; z-index: -1; }
  .sun { position: absolute; right: 9%; top: 5.5rem; width: 5.5rem; height: 5.5rem; }
  .sun::before { content: ''; position: absolute; inset: -55%; background: repeating-conic-gradient(oklch(88% 0.11 90 / 0.55) 0 9deg, transparent 9deg 22.5deg); border-radius: 50%;
    mask-image: radial-gradient(circle, transparent 38%, #000 40%, transparent 70%); }
  .sun span { position: absolute; inset: 0; border-radius: 50%; background: var(--gold); border: 4px solid var(--ink); }
  .cloud { position: absolute; fill: #fff; opacity: 0.92; shape-rendering: crispEdges; }
  .c1 { width: 11rem; top: 7rem; left: -12rem; }
  .c2 { width: 7rem; top: 14rem; left: -8rem; opacity: 0.75; }
