---
// Single source of content for the site. Facts mirror the verified portfolio notes:
// no employer, operator or customer names beyond what is already public.
const email = 'onoriagaariel@gmail.com';

const work = [
  {
    title: 'Ez-Stock',
    kind: 'Multi-tenant commerce SaaS · founder, sole engineer',
    summary:
      'Stock, point-of-sale and electronic invoicing for small and mid-size retailers. In production.',
    points: [
      'Rust backend (Axum, SQLx, Tokio) on PostgreSQL, organised as about 40 bounded contexts with 440+ migrations.',
      'Offline-capable POS that syncs when the connection returns.',
      'Transactional outbox with idempotency keys, payment-provider integration and government tax invoicing.',
      'Property-based and mutation testing; rollouts follow runbooks with precheck and rollback SQL.',
    ],
    stack: ['Rust', 'Axum', 'PostgreSQL', 'SolidJS', 'TypeScript'],
    link: { href: 'https://ez-stock.huggian.com', label: 'ez-stock.huggian.com' },
  },
  {
    title: 'Four services into one',
    kind: 'Service consolidation in Rust',
    summary:
      'Replaced four separately deployed services with a single Rust API and worker, migrated live in phases with each old service retired in turn.',
    points: [
      'Scoped API keys with quotas and usage-based billing.',
      'A telemetry ingestion platform built as six crates.',
      'Documented performance baseline before and after.',
    ],
    stack: ['Rust', 'PostgreSQL', 'Redis'],
  },
  {
    title: 'Billing, fiscal and identity platform',
    kind: 'Platform core in TypeScript',
    summary:
      'The shared platform behind the products: subscriptions, payment processing, fiscal invoicing, identity, event delivery and an admin console.',
    points: [
      '27 bounded contexts, tested against a real PostgreSQL instance.',
      'Tag-triggered CI builds and deploys.',
    ],
    stack: ['TypeScript', 'Bun', 'Hono', 'Drizzle', 'PostgreSQL'],
  },
  {
    title: 'Production infrastructure, run solo',
    kind: 'Deploys, rollback and operations',
    summary: 'Everything above runs on infrastructure I built and operate alone.',
    points: [
      'CI deploy, rollback and scheduled deploys, with health-gated rollouts and a deploy-window guard.',
      'Scale-to-zero for idle services, self-hosted secrets management and monitoring.',
    ],
    stack: ['Docker', 'nginx', 'GitHub Actions', 'systemd'],
  },
];

const experience = [
  {
    role: 'Core engineer, real-money gaming platform',
    when: 'Aug 2024 – present',
    points: [
      'Core engineer on a multi-tenant gaming platform (remote game server and back office): a Go and TypeScript monorepo on AWS serverless. About 3,700 commits, roughly 38% of the codebase.',
      'Designed and maintain five shared TypeScript libraries and a game template that the studio’s game teams build on.',
      'Terraform across Lambda, API Gateway, DynamoDB, Aurora, ECS, CloudFront and IoT Core, plus the GitHub Actions pipelines.',
      'Co-developed RNG and game-math services with Monte Carlo simulation tooling. The products passed GLI certification.',
      'Wrote the team’s internal tooling: a Rust terminal UI for multi-environment deploy status and a Go service for game scaffolding.',
    ],
  },
  {
    role: 'Founder and engineer, Huggian',
    when: 'Alongside',
    points: [
      'Built and run the commerce, billing and infrastructure products described above, end to end.',
    ],
  },
  {
    role: 'Trainee to team lead, PicallEx',
    when: 'Earlier',
    points: ['Joined as a trainee and was leading a team of seven engineers in under two years.'],
  },
  {
    role: 'Freelance engineer',
    when: 'Earlier',
    points: ['Independent client projects, including a WordPress-to-static migration that cut a client’s hosting cost by 90% and raised Lighthouse from 52 to 98.'],
  },
];

const openSource = [
  {
    name: 'lazyfetch',
    href: 'https://github.com/arielonoriaga/lazyfetch',
    what: 'Terminal HTTP client: collections, environments, Postman import, vim keys. Published on crates.io as a seven-crate hexagonal workspace with an IO-free core enforced in CI.',
    lang: 'Rust',
  },
  {
    name: 'entropy-hunter',
    href: 'https://github.com/arielonoriaga/entropy-hunter',
    what: 'Deterministic code-health analyzer for Rust and TypeScript: complexity, coupling, churn and duplication, with a regression gate for CI.',
    lang: 'TypeScript',
  },
  {
    name: 'claude-harness',
    href: 'https://github.com/arielonoriaga/claude-harness',
    what: 'Safety and self-improvement harness for AI coding agents: a guardrail hook, shared journal, test agent and review queue.',
    lang: 'Rust · Shell',
  },
  {
    name: 'lazywifi',
    href: 'https://github.com/arielonoriaga/lazywifi',
    what: 'Terminal UI for NetworkManager: wifi, ethernet, VPN and QR sharing.',
    lang: 'Rust',
  },
];

const skills = [
  ['Languages', 'Rust, TypeScript, Go, SQL, Python'],
  ['Backend', 'Axum, SQLx, Tokio, Hono, Drizzle · PostgreSQL, DynamoDB, Redis · GraphQL, MQTT, queues, outbox and idempotency patterns'],
  ['Frontend', 'SolidJS, Svelte, Vue, Astro · Phaser, PixiJS · PWA and offline sync'],
  ['Cloud and ops', 'AWS (Lambda, API Gateway, DynamoDB, Aurora, ECS, CloudFront, IoT Core, SQS/SNS) · Terraform · Docker · GitHub Actions'],
  ['Practices', 'Domain-driven and hexagonal design · property and mutation testing · AI-agent workflows with review gates'],
];

const description =
  'Ariel Onoriaga — senior Rust and TypeScript engineer. Backend, payments and commerce systems. Available for contract work with US teams.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Ariel Onoriaga — Senior Rust / TypeScript engineer</title>
    <meta name="description" content={description} />
    <meta property="og:title" content="Ariel Onoriaga — Senior Rust / TypeScript engineer" />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://arielonoriaga.huggian.com/" />
    <link rel="canonical" href="https://arielonoriaga.huggian.com/" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="color-scheme" content="light dark" />
  </head>
  <body>
    <a class="skip" href="#work">Skip to work</a>

    <header class="top">
      <p class="eyebrow">Senior Rust / TypeScript engineer · 7 years</p>
      <h1>Ariel Onoriaga</h1>
      <p class="lede">
        I design, ship and run backend systems end to end: payments, billing, commerce and the
        infrastructure underneath them.
      </p>
      <p class="avail">
        <span class="dot" aria-hidden="true"></span>
        Available for contract work, about 20 hours a week. Based in Argentina (UTC−3), working US hours.
      </p>
      <nav class="cta" aria-label="Contact">
        <a class="btn primary" href={`mailto:${email}`}>Email me</a>
        <a class="btn" href="https://www.linkedin.com/in/arielonoriaga/">LinkedIn</a>
        <a class="btn" href="https://github.com/arielonoriaga">GitHub</a>
      </nav>
    </header>

    <main>
      <section class="facts" aria-label="At a glance">
        <div><strong>7 years</strong><span>building production software</span></div>
        <div><strong>1 SaaS</strong><span>founded, built and operated solo</span></div>
        <div><strong>GLI</strong><span>certified gaming products shipped</span></div>
        <div><strong>7 crates</strong><span>published on crates.io</span></div>
      </section>

      <section id="about">
        <h2>How I work</h2>
        <p>
          I’m most useful where correctness matters and one person has to hold the whole picture:
          money movement, multi-tenant data, integrations with systems that don’t forgive retries.
          I work AI-augmented. Agents write a lot of the code; I own the architecture, the review
          and the test gates, which is how one engineer can responsibly run this much surface area.
        </p>
      </section>

      <section id="work">
        <h2>Selected work</h2>
        <div class="cards">
          {work.map((w) => (
            <article class="card">
              <p class="kind">{w.kind}</p>
              <h3>{w.title}</h3>
              <p>{w.summary}</p>
              <ul>{w.points.map((p) => <li>{p}</li>)}</ul>
              <p class="stack">{w.stack.map((s) => <span>{s}</span>)}</p>
              {w.link && <p class="more"><a href={w.link.href}>{w.link.label} →</a></p>}
            </article>
          ))}
        </div>
      </section>

      <section id="experience">
        <h2>Experience</h2>
        <ol class="timeline">
          {experience.map((e) => (
            <li>
              <p class="when">{e.when}</p>
              <div>
                <h3>{e.role}</h3>
                <ul>{e.points.map((p) => <li>{p}</li>)}</ul>
              </div>
            </li>
          ))}
        </ol>
      </section>

      <section id="open-source">
        <h2>Open source</h2>
        <p class="note">Most of my product code is private. These are the projects you can read.</p>
        <ul class="oss">
          {openSource.map((o) => (
            <li>
              <a href={o.href}>{o.name}</a>
              <span class="lang">{o.lang}</span>
              <p>{o.what}</p>
            </li>
          ))}
        </ul>
      </section>

      <section id="skills">
        <h2>Skills</h2>
        <dl class="skills">
          {skills.map(([k, v]) => (
            <>
              <dt>{k}</dt>
              <dd>{v}</dd>
            </>
          ))}
        </dl>
      </section>

      <section id="contact" class="contact">
        <h2>Work with me</h2>
        <p>
          Send three lines: what you’re building, what’s stuck, and your timeline. I reply within
          two days with a yes, a no, or a time for a 20-minute call.
        </p>
        <p><a class="btn primary" href={`mailto:${email}`}>{email}</a></p>
      </section>
    </main>

    <footer>
      <p>
        © {new Date().getFullYear()} Ariel Onoriaga ·
        <a href="https://github.com/arielonoriaga">GitHub</a> ·
        <a href="https://www.linkedin.com/in/arielonoriaga/">LinkedIn</a> ·
        <a href="https://crates.io/users/arielonoriaga">crates.io</a>
      </p>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --bg: #f6f3ee;
    --surface: #fffdf9;
    --ink: #1b1917;
    --muted: #5f5a53;
    --line: #dcd5ca;
    --accent: #a8430f;
    --accent-ink: #fffdf9;
    --ok: #2e7d4f;
    --serif: 'Iowan Old Style', 'Palatino Linotype', Palatino, Georgia, serif;
    --sans: -apple-system, 'Segoe UI', 'Helvetica Neue', Arial, 'Liberation Sans', sans-serif;
    --mono: ui-monospace, 'SF Mono', 'JetBrains Mono', Menlo, Consolas, monospace;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #141210;
      --surface: #1c1917;
      --ink: #efe9df;
      --muted: #a79f93;
      --line: #322d28;
      --accent: #e8a068;
      --accent-ink: #141210;
      --ok: #6cc08b;
    }
  }
  *, *::before, *::after { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--ink);
    font-family: var(--sans);
    font-size: 1.0625rem;
    line-height: 1.6;
  }
  .skip { position: absolute; left: -999px; }
  .skip:focus { left: 1rem; top: 1rem; background: var(--surface); padding: 0.5rem 0.75rem; }
  header.top, main, footer { max-width: 60rem; margin: 0 auto; padding: 0 1.25rem; }
  header.top { padding-top: 4.5rem; padding-bottom: 2.5rem; }
  h1, h2, h3 { font-family: var(--serif); font-weight: 600; line-height: 1.15; margin: 0; text-wrap: balance; }
  h1 { font-size: clamp(2.6rem, 7vw, 4.25rem); letter-spacing: -0.02em; }
  h2 { font-size: 1.7rem; margin-bottom: 1.1rem; }
  h3 { font-size: 1.25rem; }
  p { margin: 0 0 1rem; }
  a { color: var(--accent); text-underline-offset: 0.18em; }
  a:focus-visible, .btn:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  .eyebrow, .kind, .when, .lang {
    font-family: var(--mono); font-size: 0.78rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted);
  }
  .eyebrow { margin-bottom: 0.9rem; }
  .lede { font-family: var(--serif); font-size: clamp(1.25rem, 2.6vw, 1.6rem); line-height: 1.4; max-width: 38rem; margin-top: 1.1rem; }
  .avail { display: flex; gap: 0.6rem; align-items: baseline; color: var(--muted); max-width: 38rem; }
  .dot { flex: none; width: 0.55rem; height: 0.55rem; border-radius: 50%; background: var(--ok); transform: translateY(-0.05rem); }
  .cta { display: flex; flex-wrap: wrap; gap: 0.6rem; margin-top: 1.5rem; }
  .btn {
    display: inline-block; padding: 0.6rem 1.05rem; border: 1px solid var(--line); border-radius: 0.5rem;
    background: var(--surface); color: var(--ink); text-decoration: none; font-weight: 500;
  }
  .btn:hover { border-color: var(--accent); }
  .btn.primary { background: var(--accent); border-color: var(--accent); color: var(--accent-ink); }
  section { padding: 2.75rem 0; border-top: 1px solid var(--line); }
  .facts { display: grid; grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr)); gap: 1.25rem; padding: 2rem 0; }
  .facts strong { display: block; font-family: var(--serif); font-size: 1.7rem; line-height: 1.1; }
  .facts span { color: var(--muted); font-size: 0.95rem; }
  #about p { max-width: 42rem; }
  .cards { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.1rem; }
  .card { background: var(--surface); border: 1px solid var(--line); border-radius: 0.75rem; padding: 1.4rem 1.4rem 1.1rem; }
  .card .kind { margin-bottom: 0.45rem; }
  .card h3 { margin-bottom: 0.6rem; }
  ul { margin: 0 0 1rem; padding-left: 1.1rem; }
  li { margin-bottom: 0.4rem; }
  .card ul, .timeline ul { color: var(--muted); font-size: 0.97rem; }
  .stack { display: flex; flex-wrap: wrap; gap: 0.35rem; margin-bottom: 0.6rem; }
  .stack span { font-family: var(--mono); font-size: 0.74rem; padding: 0.15rem 0.5rem; border: 1px solid var(--line); border-radius: 999px; color: var(--muted); }
  .more { margin: 0.4rem 0 0.3rem; font-weight: 500; }
  .timeline { list-style: none; margin: 0; padding: 0; }
  .timeline > li { display: grid; grid-template-columns: 10rem 1fr; gap: 1.25rem; padding: 1.1rem 0; border-top: 1px dashed var(--line); margin: 0; }
  .timeline > li:first-child { border-top: 0; padding-top: 0; }
  .timeline h3 { margin-bottom: 0.5rem; }
  .when { margin: 0.3rem 0 0; }
  .note { color: var(--muted); }
  .oss { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.4rem 2.5rem; }
  .oss li { margin: 0; }
  .oss a { font-family: var(--mono); font-weight: 600; font-size: 1.02rem; }
  .oss .lang { margin-left: 0.5rem; }
  .oss p { margin: 0.35rem 0 0; color: var(--muted); font-size: 0.97rem; }
  .skills { display: grid; grid-template-columns: 9.5rem 1fr; gap: 0.7rem 1.25rem; margin: 0; }
  .skills dt { font-family: var(--mono); font-size: 0.78rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); padding-top: 0.25rem; }
  .skills dd { margin: 0; }
  .contact p { max-width: 38rem; }
  footer { padding-top: 1.5rem; padding-bottom: 3rem; border-top: 1px solid var(--line); color: var(--muted); font-size: 0.92rem; }
  @media (max-width: 40rem) {
    .cards, .oss { grid-template-columns: 1fr; }
    header.top { padding-top: 3rem; }
    .timeline > li { grid-template-columns: 1fr; gap: 0.3rem; }
    .skills { grid-template-columns: 1fr; gap: 0.15rem; }
    .skills dd { margin-bottom: 0.7rem; }
  }
</style>
