---
// Single source of content for the site. Facts mirror the verified portfolio notes:
// no employer, operator or customer names beyond what is already public.
//
// Look: an ink-drawn game world on Huggian's palette and type. Structures borrowed from
// games in general (HUD, achievements, quest log, crafting grid, inventory), all original
// art. Motion is CSS/SVG only, no JavaScript, and switches off under prefers-reduced-motion.
import {
  email, mailto, site, person, description, offers, faq, achievements, huggianModules, mainQuest, workspaceSplit, crafting, sideQuests,
  experience, openSource, hotbar, skills,
} from '../data/profile';
import { posts } from '../data/writing';
import Proof from '../components/Proof.astro';

const title = `${person.name} — Senior AI Engineer & Production Backend Architect`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ProfilePage',
      '@id': `${site}/#page`,
      url: `${site}/`,
      name: title,
      description,
      mainEntity: { '@id': `${site}/#ariel` },
    },
    {
      '@type': 'Person',
      '@id': `${site}/#ariel`,
      name: person.name,
      url: `${site}/`,
      image: `${site}/og.png`,
      jobTitle: 'Senior AI Engineer & Production Backend Architect',
      description,
      email: `mailto:${email}`,
      address: { '@type': 'PostalAddress', addressCountry: 'AR' },
      worksFor: { '@type': 'Organization', name: 'Huggian', url: 'https://huggian.com' },
      knowsAbout: ['AI Engineering', 'LLM Agents', 'Model Context Protocol (MCP)', 'TypeScript', 'Rust', 'Go', 'Python', 'PostgreSQL', 'Payment systems', 'Distributed systems', 'AWS', 'Terraform'],
      sameAs: [person.github, person.linkedin, person.crates],
    },
    {
      '@type': 'FAQPage',
      '@id': `${site}/#faq`,
      mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
    },
  ],
};
// Visit counter (GoatCounter pixel, no JavaScript). Empty = off.
const goatcounter = '';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={`${site}/`} />
    <meta property="og:image" content={`${site}/og.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="Ariel Onoriaga" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${site}/og.png`} />
    <meta name="author" content="Ariel Onoriaga" />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="msvalidate.01" content="8AF4EED8DC23438B1EEDCB4FA3D2BE00" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="Plain-text summary for AI assistants" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <link rel="canonical" href="https://arielonoriaga.huggian.com/" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#dcecf9" />
    <meta name="color-scheme" content="light" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Chango&family=Figtree:wght@400;500;700&family=Pixelify+Sans:wght@500;700&family=Syne:wght@700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <!-- Reusable pixel icons, drawn on an 8×8 grid. -->
    <svg class="defs" width="0" height="0" aria-hidden="true" focusable="false">
      <symbol id="i-flag" viewBox="0 0 8 8"><path d="M1 0h1v8H1z" fill="#16233b" /><path d="M2 1h5v1H6v1h1v1H2z" fill="#d2453a" /></symbol>
      <symbol id="i-shield" viewBox="0 0 8 8"><path d="M1 1h6v3H6v2H5v1H3V6H2V4H1z" fill="#1466c4" /><path d="M3 3h1v1h1V2h1v2H5v1H4V4H3z" fill="#fff" /></symbol>
      <symbol id="i-crate" viewBox="0 0 8 8"><path d="M0 1h8v6H0z" fill="#b9793f" /><path d="M0 1h8v1H0zM0 6h8v1H0zM0 1h1v6H0zM7 1h1v6H7z" fill="#6f4423" /><path d="M2 2h1v1h1v1h1v1h1v1H5V5H4V4H3V3H2z" fill="#6f4423" /></symbol>
      <symbol id="i-star" viewBox="0 0 8 8"><path d="M3 0h2v2h3v2H6v1h1v3H5V7H3v1H1V5h1V4H0V2h3z" fill="#f0b63a" /><path d="M3 2h2v1H3z" fill="#fff3c4" /></symbol>
    </svg>

    <a class="skip" href="#work">Skip to work</a>

    <header class="world">
      <div class="hud">
        <a class="hud-name" href="#top" aria-label="Ariel Onoriaga, top of page">
          <svg viewBox="0 0 64 64" aria-hidden="true"><use href="/favicon.svg#crab" /></svg>
          <span>Ariel Onoriaga</span>
        </a>
        <nav class="hud-nav" aria-label="Sections">
          <a href="#open-source">Open Source</a>
          <a href="#work">Work</a>
          <a href="#record">Proof</a>
          <a href="/writing/">Writing</a>
          <a href="/cv/">CV</a>
        </nav>
        <div class="hud-level" aria-label="Seven years of experience">
          <span>LVL 7</span>
          <span class="xp"><i></i></span>
          <span class="hud-class">Engineer</span>
        </div>
        <p class="hud-status"><i aria-hidden="true"></i>Remote · Full-time &amp; contract · UTC−3</p>
      </div>

      <div class="sky" aria-hidden="true">
        <div class="sun"><span></span></div>
        <svg class="cloud c1" viewBox="0 0 16 6"><path d="M4 0h6v1h3v1h2v2h1v2H0V4h1V2h2V1h1z" /></svg>
        <svg class="cloud c2" viewBox="0 0 16 6"><path d="M4 0h6v1h3v1h2v2h1v2H0V4h1V2h2V1h1z" /></svg>
        <svg class="cloud c3" viewBox="0 0 16 6"><path d="M4 0h6v1h3v1h2v2h1v2H0V4h1V2h2V1h1z" /></svg>
      </div>

      <div class="stagewrap" id="top">
        <div class="intro">
          <p class="eyebrow">Player one · AI Systems, TypeScript &amp; Rust</p>
          <h1><span>Ariel</span> <span>Onoriaga</span></h1>
          <p class="lede">{person.role}.</p>
          <p class="proof">
            I build production AI systems and the high-reliability backends behind them — agentic
            workflows, MCP tooling, deterministic guardrails and money-movement platforms. Seven
            years in, shipping GLI-certified AWS systems and the Huggian Rust/TypeScript suite.
          </p>
          <nav class="cta" aria-label="Contact">
            <a class="btn primary" href={mailto}>Email me</a>
            <a class="btn" href="https://www.linkedin.com/in/arielonoriaga/">LinkedIn</a>
            <a class="btn" href="https://github.com/arielonoriaga">GitHub</a>
            <a class="btn" href="/ariel-onoriaga-cv.pdf">CV (PDF)</a>
          </nav>
        </div>

        <div class="stage">
          <!-- A nod to the Huggian product graph: the things I built, and room for yours. -->
          <svg class="constellation" viewBox="0 0 390 258" role="img" aria-label="Huggian products I built: Huggian connected to ez-commerce, ez-catalog, ez-contador, ez-rails, ez-cochera, and one open node labelled your project.">
            <g class="links">
              <path d="M174 48 L76 112" />
              <path d="M174 48 L280 62" />
              <path d="M174 48 L244 148" />
              <path d="M76 112 L280 62" />
              <path d="M76 112 L72 202" />
              <path d="M76 112 L244 148" />
              <path d="M76 112 L176 214" />
              <path d="M72 202 L244 148" />
              <path d="M176 214 L72 202" />
              <path d="M176 214 L244 148" />
              <path class="open" d="M174 48 Q338 92 336 204" />
            </g>
            <g class="node n0"><circle cx="174" cy="48" r="11" /><text x="174" y="26">Huggian</text></g>
            <g class="node n1"><circle cx="76" cy="112" r="12" /><text x="58" y="88">ez-commerce</text></g>
            <g class="node n2"><circle cx="280" cy="62" r="9" /><text x="280" y="42">ez-catalog</text></g>
            <g class="node n3"><circle cx="72" cy="202" r="8.5" /><text x="72" y="228">ez-contador</text></g>
            <g class="node n4"><circle cx="244" cy="148" r="9.5" /><text class="lbl-r" x="256" y="168">ez-rails</text></g>
            <g class="node n5"><circle cx="176" cy="214" r="8.5" /><text x="176" y="240">ez-cochera</text></g>
            <g class="node n6"><circle cx="336" cy="204" r="9.5" /><text x="336" y="232">your team?</text></g>
          </svg>

          <div class="walker">
            <p class="bubble" aria-hidden="true"><span>hi!</span><span>cargo build ✓</span><span>tests green</span></p>
            <svg class="crab" viewBox="0 0 260 240" role="img" aria-label="A cartoon crab walking sideways and waving">
              <ellipse class="crab-shadow" cx="130" cy="224" rx="78" ry="9" />
              <g class="crab-hop"><g class="crab-all">
                <g class="legs legs-l"><path d="M82 168 Q52 176 44 208" /><path d="M94 176 Q70 190 68 214" /><path d="M108 180 Q94 196 96 216" /></g>
                <g class="legs legs-r"><path d="M178 168 Q208 176 216 208" /><path d="M166 176 Q190 190 192 214" /><path d="M152 180 Q166 196 164 216" /></g>
                <g class="arm arm-l">
                  <path class="hose" d="M70 138 Q34 128 34 92" />
                  <path class="claw-top" d="M34 92 Q10 86 12 60 Q22 40 44 46 Q38 62 34 92 Z" />
                  <path class="claw-bot" d="M34 92 Q58 88 60 64 Q54 50 44 46 Q46 66 34 92 Z" />
                </g>
                <g class="arm arm-r">
                  <path class="hose" d="M190 138 Q226 128 226 92" />
                  <path class="claw-top" d="M226 92 Q250 86 248 60 Q238 40 216 46 Q222 62 226 92 Z" />
                  <path class="claw-bot" d="M226 92 Q202 88 200 64 Q206 50 216 46 Q214 66 226 92 Z" />
                </g>
                <path class="stalk" d="M108 104 Q104 86 106 70" /><path class="stalk" d="M152 104 Q156 86 154 70" />
                <ellipse class="shell" cx="130" cy="142" rx="68" ry="46" />
                <path class="shine" d="M84 124 Q98 104 124 102" />
                <g class="eye"><ellipse class="white" cx="106" cy="58" rx="17" ry="24" /><g class="look"><ellipse class="pupil" cx="108" cy="62" rx="8" ry="13" /><path class="glint" d="M108 62 L119 53 L119 65 Z" /></g></g>
                <g class="eye"><ellipse class="white" cx="154" cy="58" rx="17" ry="24" /><g class="look"><ellipse class="pupil" cx="156" cy="62" rx="8" ry="13" /><path class="glint" d="M156 62 L167 53 L167 65 Z" /></g></g>
                <path class="mouth" d="M100 146 Q130 182 160 146 Q130 156 100 146 Z" />
                <path class="tongue" d="M118 162 Q130 172 142 162 Q130 158 118 162 Z" />
                <circle class="cheek" cx="92" cy="150" r="7" /><circle class="cheek" cx="168" cy="150" r="7" />
              </g></g>
            </svg>
          </div>
        </div>
      </div>

      <div class="ground" aria-hidden="true"><span class="sign">work ↓</span></div>
    </header>

    <main>
      <section class="achievements" aria-label="Achievements">
        <p class="tag" aria-hidden="true">Achievements unlocked</p>
        <h2 class="h">Highlights</h2>
        <ul>
          {achievements.map((a) => (
            <li>
              <svg class="pix" viewBox="0 0 8 8" aria-hidden="true"><use href={`#i-${a.icon}`} /></svg>
              <div><strong>{a.title}</strong><span>{a.text}</span></div>
            </li>
          ))}
        </ul>
      </section>

      <section id="open-source">
        <p class="tag" aria-hidden="true">Open-source drops</p>
        <h2 class="h">Open source</h2>
        <p class="note">Most of my product code is private. These are the projects you can read.</p>
        <ul class="oss">
          {openSource.map((o) => (
            <li>
              <a href={o.href}>{o.name}</a>
              <span class="lang">{o.lang}</span>
              <p>{o.what}</p>
            </li>
          ))}
        </ul>
      </section>

      <section id="services">
        <p class="tag" aria-hidden="true">Party role</p>
        <h2 class="h">What I can take off your plate</h2>
        <ol class="offers">
          {offers.map((o) => (
            <li>
              <h3>{o.title}</h3>
              <p>{o.text}</p>
              <p class="done">{o.proof}</p>
            </li>
          ))}
        </ol>
      </section>

      <section id="about" class="about">
        <p class="tag" aria-hidden="true">How I play</p>
        <h2 class="h">How I work</h2>
        <p class="big">
          I’m most useful where <mark>AI agents meet production state</mark> and mistakes cost
          money: deterministic tool-call guardrails, MCP memory, idempotent payments and
          multi-tenant backends that survive retries.
        </p>
        <p>
          I build AI-native with strict verification gates — the same architecture, review and test
          discipline I use to ship autonomous workflows safely to paying users.
        </p>
      </section>

      <section id="work">
        <p class="tag" aria-hidden="true">Quest log</p>
        <h2 class="h">Selected work</h2>

        <article class="quest main">
          <div>
            <p class="kind">{mainQuest.kind}</p>
            <h3>{mainQuest.title}</h3>
            <p class="sum">{mainQuest.summary}</p>
            <p class="stack">{mainQuest.stack.map((s) => <span>{s}</span>)}</p>
            <p class="more"><a href={mainQuest.link.href}>{mainQuest.link.label} →</a></p>
          </div>
          <ul>{mainQuest.points.map((p) => <li>{p}</li>)}</ul>
        </article>

        <article class="quest craft">
          <div class="bench" aria-hidden="true">
            <div class="grid">{workspaceSplit.inputs.map((i) => <span class="slot">{i}</span>)}</div>
            <span class="arrow">→</span>
            <span class="slot out">{workspaceSplit.output}</span>
          </div>
          <div>
            <p class="kind">{workspaceSplit.kind}</p>
            <h3>{workspaceSplit.title}</h3>
            <p class="sum">{workspaceSplit.summary}</p>
            <ul>{workspaceSplit.points.map((p) => <li>{p}</li>)}</ul>
            <p class="stack">{workspaceSplit.stack.map((s) => <span>{s}</span>)}</p>
          </div>
        </article>

        <article class="quest craft">
          <div class="bench" aria-hidden="true">
            <div class="grid">{crafting.inputs.map((i) => <span class="slot">{i}</span>)}</div>
            <span class="arrow">→</span>
            <span class="slot out">{crafting.output}</span>
          </div>
          <div>
            <p class="kind">{crafting.kind}</p>
            <h3>{crafting.title}</h3>
            <p class="sum">{crafting.summary}</p>
            <ul>{crafting.points.map((p) => <li>{p}</li>)}</ul>
            <p class="stack">{crafting.stack.map((s) => <span>{s}</span>)}</p>
          </div>
        </article>

        <div class="sides">
          {sideQuests.map((q) => (
            <article class="quest side">
              <p class="kind">{q.kind}</p>
              <h3>{q.title}</h3>
              <p class="sum">{q.summary}</p>
              <ul>{q.points.map((p) => <li>{p}</li>)}</ul>
              <p class="stack">{q.stack.map((s) => <span>{s}</span>)}</p>
            </article>
          ))}
        </div>
      </section>

      <Proof />

      <section id="experience">
        <p class="tag" aria-hidden="true">Campaign history</p>
        <h2 class="h">Experience</h2>
        <ol class="campaign">
          {experience.map((e) => (
            <li>
              <p class="when">
                <span class={`status ${e.status.toLowerCase()}`}>{e.status}</span>
                {e.when}
              </p>
              <div>
                <h3>{e.role}</h3>
                <ul>{e.points.map((p) => <li>{p}</li>)}</ul>
              </div>
            </li>
          ))}
        </ol>
      </section>

      <section id="huggian" class="huggian-modules" aria-labelledby="huggian-h">
        <p class="tag" aria-hidden="true">Product ecosystem</p>
        <h2 class="h" id="huggian-h">Huggian modules</h2>
        <p class="note">Five connected products plus a browser-only tools hub, sharing identity, billing and tax rails on <a href="https://huggian.com">huggian.com</a>.</p>
        <div class="mod-grid">
          {huggianModules.map((m) => (
            <article class="mod" style={`--mod-accent:${m.hex}`}>
              <header class="mod-head">
                <h3><i class="mod-dot" aria-hidden="true"></i>{m.name}</h3>
                <span class="mod-kind">{m.kind}</span>
              </header>
              <p class="mod-sum">{m.summary}</p>
              <p class="mod-built"><strong>Built:</strong> {m.built}</p>
              <p class="mod-link"><a href={m.href}>{m.label} →</a></p>
            </article>
          ))}
        </div>
      </section>

      <section id="writing">
        <p class="tag" aria-hidden="true">Field notes</p>
        <h2 class="h">Writing</h2>
        <ul class="oss notes">
          {posts.map((p) => (
            <li>
              <a href={`/writing/${p.slug}/`}>{p.title}</a>
              <p>{p.description}</p>
            </li>
          ))}
        </ul>
      </section>

      <section id="skills">
        <p class="tag" aria-hidden="true">Inventory</p>
        <h2 class="h">Skills</h2>
        <ul class="hotbar" aria-label="Core tools">
          {hotbar.map((h, i) => <li><small>{i + 1}</small>{h}</li>)}
        </ul>
        <dl class="skills">
          {skills.map(([k, v]) => (
            <>
              <dt>{k}</dt>
              <dd>{v}</dd>
            </>
          ))}
        </dl>
      </section>

      <section id="faq">
        <p class="tag" aria-hidden="true">Tutorial</p>
        <h2 class="h">Questions people ask first</h2>
        <div class="faq">
          {faq.map((f) => (
            <details>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </section>

      <section id="contact" class="coop">
        <div>
          <p class="tag">Player two wanted</p>
          <h2>Hiring a Senior AI or Backend Engineer?</h2>
          <p>
            Send a short note about your team, the hard problem on your roadmap, and your timeline.
            Full-time remote or senior contract on US hours (UTC−3).
          </p>
          <p class="cta">
            <a class="btn primary" href={mailto}>{email}</a>
            <a class="btn" href="https://www.linkedin.com/in/arielonoriaga/">LinkedIn</a>
            <a class="btn" href="/ariel-onoriaga-cv.pdf">CV (PDF)</a>
          </p>
        </div>
      </section>
    </main>

    {goatcounter && <img class="count" src={`https://${goatcounter}.goatcounter.com/count?p=/`} alt="" width="1" height="1" />}
    <footer>
      <p>
        © {new Date().getFullYear()} Ariel Onoriaga ·
        <a href="https://github.com/arielonoriaga">GitHub</a> ·
        <a href="https://www.linkedin.com/in/arielonoriaga/">LinkedIn</a> ·
        <a href="https://crates.io/users/arielonoriaga">crates.io</a> ·
        <a href="/writing/">Writing</a> ·
        <a href="/cv/">CV</a>
      </p>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    /* Huggian's cool paper and blue accent, plus the product colours from its graph. */
    --void: oklch(98% 0.006 240);
    --surface: #fff;
    --deep: oklch(95.5% 0.012 240);
    --sky: oklch(91% 0.045 235);
    --ink: oklch(24% 0.045 255);
    --ink-dark: oklch(20% 0.04 255);
    --ink-soft: oklch(42% 0.04 250);
    --rule: oklch(86% 0.02 245);
    --huggian: #3A5A78;
    --blue: oklch(50% 0.2 235);
    --blue-deep: oklch(40% 0.18 240);
    --orange: #E8622C;
    --teal: #14B8A6;
    --contador: #3B82F6;
    --rails: #F7BF2E;
    --cochera: #8B5CF6;
    --red: oklch(60% 0.19 28);
    --gold: oklch(80% 0.15 85);
    --grass: oklch(66% 0.15 150);
    --grass-dark: oklch(52% 0.13 152);
    --dirt: oklch(55% 0.08 60);
    --dirt-dark: oklch(44% 0.07 55);
    --cloud: #fff;
    --sun-fill: var(--gold);
    --sun-rays: oklch(88% 0.11 90 / 0.55);
    --inv-bg: var(--ink);
    --inv-fg: var(--void);
    --inv-muted: oklch(90% 0.02 240);
    --slot-bg: oklch(86% 0.02 250);
    --slot-hi: oklch(96% 0.01 250);
    --slot-lo: oklch(72% 0.03 250);
    --cal-stroke: oklch(24% 0.045 255 / 0.08);
    --cal-0: oklch(94% 0.012 245);
    --cal-1: oklch(85% 0.07 152);
    --cal-2: oklch(74% 0.13 152);
    --cal-3: oklch(62% 0.15 152);
    --cal-4: oklch(48% 0.13 155);
    --heat-base: oklch(95% 0.02 60);
    --display: 'Syne', 'Avenir Next', 'Segoe UI', sans-serif;
    --title: 'Chango', 'Cooper Black', 'Arial Black', serif;
    --pixel: 'Pixelify Sans', ui-monospace, 'Courier New', monospace;
    --body: 'Figtree', -apple-system, 'Segoe UI', 'Helvetica Neue', Arial, 'Liberation Sans', sans-serif;
    --px: 4px; /* one "pixel" of the world art */
    --ease: cubic-bezier(0.16, 1, 0.3, 1);
  }

  *, *::before, *::after { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; scroll-behavior: smooth; }
  body { margin: 0; background: var(--void); color: var(--ink); font-family: var(--body); font-size: 1.0625rem; line-height: 1.6; overflow-x: hidden; }
  .defs { position: absolute; }
  .skip { position: absolute; left: -999px; z-index: 30; }
  .skip:focus { left: 1rem; top: 1rem; background: var(--void); padding: 0.5rem 0.75rem; border: 3px solid var(--ink); }
  a { color: var(--blue-deep); text-underline-offset: 0.2em; text-decoration-thickness: 2px; }
  a:focus-visible, .btn:focus-visible { outline: 3px solid var(--blue); outline-offset: 3px; }
  h1, h2, h3 { margin: 0; line-height: 1.08; text-wrap: balance; }
  p { margin: 0 0 1rem; }
  ul { margin: 0 0 1rem; padding-left: 1.15rem; }
  li { margin-bottom: 0.4rem; }
  mark { background: linear-gradient(transparent 62%, var(--gold) 62% 92%, transparent 92%); color: inherit; }

  /* ── World: sky, HUD, stage and ground ── */
  .world { position: relative; isolation: isolate; overflow: hidden; background: linear-gradient(var(--sky), var(--deep) 70%, var(--void)); }
  .hud { position: relative; z-index: 3; display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 1.05rem; max-width: 70rem; margin: 0 auto; padding: 0.9rem 1.25rem;
    font-family: var(--pixel); font-size: 0.9rem; }
  .hud-name { display: flex; align-items: center; gap: 0.5rem; color: var(--ink); text-decoration: none; font-family: var(--display); font-weight: 800; font-size: 0.9rem; letter-spacing: 0.11em; text-transform: uppercase; }
  .hud-name svg { width: 1.75rem; height: 1.75rem; }
  .hud-nav { display: flex; flex-wrap: wrap; align-items: center; gap: 0.35rem 0.85rem; }
  .hud-nav a { color: var(--ink); text-decoration: none; padding: 0.1rem 0; border-bottom: 2px solid transparent; }
  .hud-nav a:hover { color: var(--blue-deep); border-bottom-color: var(--blue); }
  .hud-level { display: flex; align-items: center; gap: 0.45rem; margin-left: auto; }
  .xp { width: 4.8rem; height: 0.78rem; border: 2px solid var(--ink); background: var(--void); padding: 1px; }
  .xp i { display: block; height: 100%; width: 78%; background: repeating-linear-gradient(90deg, var(--grass) 0 6px, var(--grass-dark) 6px 8px); }
  .hud-class { color: var(--ink-soft); }
  .hud-status { margin: 0; display: flex; align-items: center; gap: 0.45rem; }
  .hud-status i { width: 0.65rem; height: 0.65rem; background: var(--grass); border: 2px solid var(--ink); }

  .sky { position: absolute; inset: 0; z-index: -1; }
  .sun { position: absolute; right: 4%; top: 3.6rem; width: 4.5rem; height: 4.5rem; }
  .sun::before { content: ''; position: absolute; inset: -55%; background: repeating-conic-gradient(var(--sun-rays) 0 9deg, transparent 9deg 22.5deg); border-radius: 50%;
    mask-image: radial-gradient(circle, transparent 38%, #000 40%, transparent 70%); }
  .sun span { position: absolute; inset: 0; border-radius: 50%; background: var(--sun-fill); border: 4px solid var(--ink); }
  .cloud { position: absolute; fill: var(--cloud); opacity: 0.92; shape-rendering: crispEdges; }
  .c1 { width: 11rem; top: 7rem; left: -12rem; }
  .c2 { width: 7rem; top: 14rem; left: -8rem; opacity: 0.75; }
  .c3 { width: 15rem; top: 21rem; left: -16rem; opacity: 0.6; }

  .stagewrap { display: grid; grid-template-columns: minmax(0, 1.02fr) minmax(0, 0.98fr); gap: 2rem; align-items: end; max-width: 70rem; margin: 0 auto;
    padding: clamp(1.5rem, 4.5vw, 3.25rem) 1.25rem 0; min-height: clamp(31rem, 76vh, 45rem); }
  .intro { padding-bottom: clamp(3rem, 5.5vw, 4.2rem); }
  .eyebrow, .tag, .kind, .when, .lang { font-family: var(--pixel); font-weight: 500; letter-spacing: 0.04em; }
  .eyebrow { font-size: 1.05rem; color: var(--blue-deep); margin-bottom: 0.65rem; }
  h1 { font-family: var(--title); font-weight: 400; font-size: clamp(3rem, 9vw, 6.25rem); line-height: 0.98; color: var(--red);
    -webkit-text-stroke: 2px var(--ink-dark); paint-order: stroke fill; text-shadow: 3px 3px 0 var(--ink-dark), 7px 7px 0 var(--gold), 9px 9px 0 var(--ink-dark); }
  h1 span { display: inline-block; }
  h1 span:nth-child(2) { rotate: -1.5deg; }
  .lede { font-family: var(--display); font-weight: 700; font-size: clamp(1.28rem, 2.4vw, 1.7rem); line-height: 1.24; max-width: 34rem; margin-top: 1.35rem; letter-spacing: -0.01em; }
  .proof { max-width: 32rem; color: var(--ink-soft); }
  .cta { display: flex; flex-wrap: wrap; gap: 0.75rem; margin: 1.25rem 0 0; }
  .btn { display: inline-block; padding: 0.65rem 1.15rem; border: 3px solid var(--ink); border-radius: 2px; background: var(--surface); color: var(--ink);
    text-decoration: none; font-weight: 700; box-shadow: 4px 4px 0 var(--ink); transition: translate 0.12s, box-shadow 0.12s; }
  .btn:hover { translate: -2px -2px; box-shadow: 6px 6px 0 var(--ink); }
  .btn:active { translate: 3px 3px; box-shadow: 1px 1px 0 var(--ink); }
  .btn.primary { background: var(--blue); color: #fff; }

  .stage { position: relative; z-index: 2; align-self: stretch; min-height: 31rem; }
  .constellation { position: absolute; right: 0; top: 0; width: min(100%, 26rem); overflow: visible; }
  .links path { fill: none; stroke: var(--ink-soft); stroke-width: 1.6; stroke-dasharray: 320; stroke-dashoffset: 0; opacity: 0.55; }
  .links .open { stroke-dasharray: 5 6; stroke: var(--blue-deep); opacity: 0.85; }
  .node circle { stroke: var(--ink); stroke-width: 3; }
  .node text { font-family: var(--pixel); font-size: 13px; text-anchor: middle; fill: var(--ink); }
  .node .lbl-r { text-anchor: start; }
  .n0 circle { fill: var(--huggian); }
  .n1 circle { fill: var(--orange); }
  .n2 circle { fill: var(--teal); }
  .n3 circle { fill: var(--contador); }
  .n4 circle { fill: var(--rails); }
  .n5 circle { fill: var(--cochera); }
  .n6 circle { fill: var(--void); stroke-dasharray: 4 4; }
  .n6 text { fill: var(--blue-deep); }
  .node { transform-box: fill-box; transform-origin: center; }

  /* The crab walks sideways along the ground, as crabs do. */
  .walker { position: absolute; bottom: -6px; left: 0; width: clamp(12.5rem, 26vw, 19rem); }
  .crab { display: block; width: 100%; overflow: visible; cursor: grab; }
  .crab * { stroke: var(--ink); stroke-width: 6; stroke-linecap: round; stroke-linejoin: round; }
  .crab-shadow { fill: oklch(24% 0.045 255 / 0.2); stroke: none; }
  .legs path, .hose, .stalk { fill: none; stroke-width: 8; }
  .shell, .claw-top, .claw-bot { fill: var(--red); }
  .shine { fill: none; stroke: oklch(85% 0.08 28); stroke-width: 5; }
  .white { fill: #fff; stroke-width: 5; }
  .pupil { fill: var(--ink); stroke: none; }
  .glint { fill: #fff; stroke: none; }
  .mouth { fill: var(--ink); }
  .tongue, .cheek { fill: oklch(76% 0.12 25); stroke: none; }
  .crab-hop, .crab-all, .legs, .arm, .eye, .claw-top, .crab-shadow, .look { transform-box: fill-box; }
  .crab-all, .crab-hop { transform-origin: 50% 100%; }
  .arm-l { transform-origin: 100% 100%; } .arm-r { transform-origin: 0% 100%; }
  .arm-l .claw-top { transform-origin: 80% 100%; } .arm-r .claw-top { transform-origin: 20% 100%; }
  .eye { transform-origin: 50% 100%; }
  .legs-l { transform-origin: 100% 0%; } .legs-r { transform-origin: 0% 0%; }
  .crab-shadow { transform-origin: 50% 50%; }
  .bubble { position: absolute; left: 62%; bottom: 82%; margin: 0; font-family: var(--pixel); font-size: 1rem; white-space: nowrap; }
  .bubble span { position: absolute; left: 0; bottom: 0; background: var(--surface); color: var(--ink); border: 3px solid var(--ink); padding: 0.2rem 0.6rem; box-shadow: 3px 3px 0 var(--ink); opacity: 0; }
  .bubble span:first-child { opacity: 1; }

  .ground { position: relative; z-index: 1; height: calc(var(--px) * 22); border-top: var(--px) solid var(--ink);
    background:
      repeating-linear-gradient(90deg, var(--grass-dark) 0 var(--px), transparent var(--px) calc(var(--px) * 5), var(--grass-dark) calc(var(--px) * 5) calc(var(--px) * 7), transparent calc(var(--px) * 7) calc(var(--px) * 11)) 0 calc(var(--px) * 4) / auto var(--px) no-repeat,
      linear-gradient(var(--grass) 0 calc(var(--px) * 4), transparent 0),
      radial-gradient(var(--dirt-dark) calc(var(--px) * 0.9), transparent calc(var(--px) * 1)) 0 calc(var(--px) * 7) / calc(var(--px) * 9) calc(var(--px) * 7),
      radial-gradient(oklch(70% 0.02 250) calc(var(--px) * 0.8), transparent calc(var(--px) * 0.9)) calc(var(--px) * 4) calc(var(--px) * 10) / calc(var(--px) * 17) calc(var(--px) * 9),
      var(--dirt); }
  .sign { position: absolute; left: max(1.25rem, calc(50% - 33.75rem)); bottom: 100%; font-family: var(--pixel); font-size: 0.95rem; background: var(--gold); color: var(--ink-dark); border: 3px solid var(--ink);
    padding: 0.1rem 0.55rem; translate: 0 -0.75rem; }
  .sign::after { content: ''; position: absolute; left: 50%; top: 100%; width: 4px; height: 0.95rem; background: var(--ink); translate: -50% 0; }

  /* ── Sections ── */
  main, footer { max-width: 70rem; margin: 0 auto; padding: 0 1.25rem; }
  section { padding: clamp(2.75rem, 6vw, 4.5rem) 0 0; }
  .tag { display: inline-block; font-size: 1rem; line-height: 1; color: var(--void); background: var(--ink); padding: 0.4rem 0.7rem 0.35rem; margin: 0 0 0.7rem; }
  .h { font-family: var(--display); font-weight: 800; font-size: clamp(1.7rem, 3.6vw, 2.5rem); letter-spacing: -0.02em; margin-bottom: 1.5rem; }
  h3 { font-family: var(--display); font-weight: 800; letter-spacing: -0.015em; }
  .offers { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0 2.25rem; counter-reset: offer; }
  .offers li { margin: 0; padding-top: 1rem; border-top: 6px solid var(--ink); counter-increment: offer; }
  .offers li:nth-child(1) { border-color: var(--orange); } .offers li:nth-child(2) { border-color: var(--blue); } .offers li:nth-child(3) { border-color: var(--teal); }
  .offers h3 { font-size: 1.4rem; margin-bottom: 0.6rem; }
  .offers h3::before { content: '0' counter(offer) ' '; font-family: var(--pixel); font-weight: 500; font-size: 0.95rem; color: var(--ink-soft); display: block; margin-bottom: 0.35rem; letter-spacing: 0.04em; }
  .offers p { color: var(--ink-soft); }
  .offers .done { font-family: var(--pixel); font-size: 0.95rem; color: var(--blue-deep); }
  .faq { max-width: 48rem; border-top: 3px solid var(--ink); }
  .faq details { border-bottom: 3px solid var(--ink); }
  .faq summary { cursor: pointer; list-style: none; display: flex; justify-content: space-between; gap: 1rem; padding: 0.95rem 0; font-family: var(--display); font-weight: 700; font-size: 1.15rem; }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary::after { content: '+'; font-family: var(--pixel); font-size: 1.4rem; line-height: 1; color: var(--blue); }
  .faq details[open] summary::after { content: '–'; }
  .faq summary:hover { color: var(--blue-deep); }
  .faq details p { color: var(--ink-soft); max-width: 42rem; margin: 0 0 1.1rem; }
  .count { position: absolute; width: 1px; height: 1px; opacity: 0; }
  .kind, .when, .lang { font-size: 0.95rem; color: var(--blue-deep); }

  .achievements ul { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1rem; }
  .achievements li { display: flex; gap: 0.8rem; align-items: flex-start; margin: 0; background: var(--inv-bg); color: var(--inv-fg); padding: 0.85rem 0.9rem; border: 3px solid var(--ink); box-shadow: 4px 4px 0 var(--blue); }
  .achievements li:nth-child(even) { translate: 0 0.9rem; }
  .pix { flex: none; width: 2.5rem; height: 2.5rem; background: var(--void); padding: 0.3rem; shape-rendering: crispEdges; }
  .achievements strong { display: block; font-family: var(--pixel); font-size: 1.1rem; color: var(--gold); line-height: 1.2; }
  .achievements span { display: block; font-size: 0.92rem; line-height: 1.4; color: var(--inv-muted); }

  .about { max-width: 46rem; }
  .big { font-family: var(--display); font-weight: 700; font-size: clamp(1.35rem, 2.9vw, 2rem); line-height: 1.25; letter-spacing: -0.015em; }

  .mod-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.25rem; margin-top: 1.15rem; }
  .mod { display: flex; flex-direction: column; gap: 0.55rem; border: 3px solid var(--ink); border-top: 7px solid var(--mod-accent, var(--blue)); border-radius: 2px; background: var(--surface); box-shadow: 5px 5px 0 var(--ink); padding: 1.1rem 1.15rem 1rem; }
  .mod-head { display: flex; justify-content: space-between; align-items: center; gap: 0.5rem; flex-wrap: wrap; }
  .mod h3 { display: inline-flex; align-items: center; gap: 0.5rem; font-size: 1.22rem; color: var(--ink); }
  .mod-dot { width: 0.72rem; height: 0.72rem; border-radius: 50%; background: var(--mod-accent, var(--blue)); border: 2px solid var(--ink); flex: none; }
  .mod-kind { font-family: var(--pixel); font-size: 0.85rem; padding: 0.05rem 0.45rem; border: 2px solid var(--ink); background: var(--deep); color: var(--ink); }
  .mod-sum { margin: 0; font-weight: 500; font-size: 0.98rem; line-height: 1.45; color: var(--ink); }
  .mod-built { margin: 0; font-size: 0.91rem; line-height: 1.48; color: var(--ink-soft); flex-grow: 1; }
  .mod-built strong { font-family: var(--pixel); font-weight: 500; color: var(--ink); }
  .mod-link { margin: 0.25rem 0 0; font-family: var(--pixel); font-size: 0.92rem; }
  .mod-link a { font-weight: 700; }

  .quest { border: 3px solid var(--ink); background: var(--surface); box-shadow: 6px 6px 0 var(--ink); padding: clamp(1.2rem, 3vw, 1.9rem); }
  .quest h3 { font-size: clamp(1.5rem, 3vw, 2rem); margin: 0.3rem 0 0.7rem; }
  .quest ul { color: var(--ink-soft); font-size: 0.99rem; }
  .quest li::marker { content: '▸ '; color: var(--blue); }
  .sum { font-weight: 500; }
  .stack { display: flex; flex-wrap: wrap; gap: 0.4rem; margin: 0 0 0.5rem; }
  .stack span { font-family: var(--pixel); font-size: 0.9rem; padding: 0.05rem 0.5rem; border: 2px solid var(--ink); background: var(--deep); color: var(--ink); }
  .more { margin: 0.6rem 0 0; font-weight: 700; }
  .quest.main { display: grid; grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr); gap: 1.5rem 2.5rem; align-items: start; border-left-width: 12px; border-left-color: var(--orange); }
  .quest.main h3 { font-size: clamp(2.2rem, 5vw, 3.4rem); }
  .quest.craft { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 1.5rem 2.5rem; align-items: center; margin: 1.75rem 0 0 clamp(0rem, 6vw, 5rem); background: var(--deep); }
  .bench { display: flex; align-items: center; gap: 0.9rem; font-family: var(--pixel); }
  .bench .grid { display: grid; grid-template-columns: repeat(2, 4.8rem); gap: 0.35rem; }
  .slot { display: grid; place-items: center; text-align: center; height: 4.5rem; padding: 0.2rem; background: var(--slot-bg); color: var(--ink); border: 3px solid var(--ink);
    box-shadow: inset 3px 3px 0 var(--slot-hi), inset -3px -3px 0 var(--slot-lo); font-size: 0.88rem; line-height: 1.05; }
  .slot.out { width: 6.8rem; height: 6.8rem; background: var(--gold); color: var(--ink-dark); box-shadow: inset 3px 3px 0 oklch(92% 0.09 90), inset -3px -3px 0 oklch(66% 0.14 75); padding: 0.35rem; font-size: 0.95rem; }
  .arrow { font-size: 2rem; line-height: 1; }
  .sides { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr); gap: 1.75rem; margin-top: 1.75rem; align-items: start; }
  .quest.side:last-child { margin-top: 2.25rem; }

  .campaign { list-style: none; margin: 0; padding: 0; }
  .campaign > li { display: grid; grid-template-columns: 11.5rem 1fr; gap: 1.5rem; padding: 1.3rem 0; border-top: 3px solid var(--ink); margin: 0; }
  .campaign h3 { font-size: 1.35rem; margin-bottom: 0.55rem; }
  .campaign ul { color: var(--ink-soft); font-size: 0.99rem; }
  .when { margin: 0.2rem 0 0; display: flex; flex-direction: column; align-items: flex-start; gap: 0.45rem; }
  .status { font-size: 0.85rem; padding: 0.05rem 0.45rem; border: 2px solid var(--ink); color: var(--ink); background: var(--deep); }
  .status.active { background: var(--grass); color: var(--ink-dark); }

  .note { color: var(--ink-soft); }
  .oss { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.6rem 2.75rem; }
  .oss li { margin: 0; }
  .oss a { font-family: var(--display); font-weight: 800; font-size: 1.3rem; color: var(--ink); text-decoration-color: var(--teal); text-decoration-thickness: 4px; }
  .oss a:hover { color: var(--blue-deep); }
  .oss .lang { margin-left: 0.6rem; }
  .oss p { margin: 0.45rem 0 0; color: var(--ink-soft); font-size: 0.99rem; }
  .notes a { font-size: 1.2rem; line-height: 1.25; text-decoration-color: var(--orange); }

  .hotbar { list-style: none; display: flex; flex-wrap: wrap; gap: 0.35rem; padding: 0.4rem; margin: 0 0 1.75rem; width: fit-content; max-width: 100%; background: var(--inv-bg); }
  .hotbar li { position: relative; display: grid; place-items: center; width: 5.6rem; height: 4.4rem; margin: 0; font-family: var(--pixel); font-size: 1rem;
    background: var(--slot-bg); color: var(--ink); box-shadow: inset 3px 3px 0 var(--slot-hi), inset -3px -3px 0 var(--slot-lo); transition: translate 0.15s var(--ease); }
  .hotbar li:hover { translate: 0 -5px; background: var(--gold); color: var(--ink-dark); }
  .hotbar small { position: absolute; left: 0.35rem; top: 0.15rem; font-size: 0.75rem; color: var(--ink-soft); }
  .skills { display: grid; grid-template-columns: 10rem 1fr; gap: 0.8rem 1.5rem; margin: 0; max-width: 54rem; }
  .skills dt { font-family: var(--pixel); font-size: 1rem; color: var(--blue-deep); padding-top: 0.1rem; }
  .skills dd { margin: 0; }

  .coop { margin: clamp(3rem, 7vw, 5rem) 0 3rem; padding: 0; }
  .coop > div { background: var(--inv-bg); color: var(--inv-fg); padding: clamp(2rem, 6vw, 4rem); border: 3px solid var(--ink); box-shadow: 8px 8px 0 var(--blue); }
  .coop .tag { background: var(--gold); color: var(--ink-dark); margin-bottom: 1.2rem; }
  .coop h2 { font-family: var(--display); font-weight: 800; font-size: clamp(1.8rem, 4.6vw, 3.2rem); letter-spacing: -0.02em; max-width: 36rem; margin-bottom: 1rem; }
  .coop p { max-width: 36rem; }
  .coop .btn { border-color: var(--inv-fg); box-shadow: 4px 4px 0 var(--gold); }
  .coop .btn:hover { box-shadow: 6px 6px 0 var(--gold); }
  footer { padding-bottom: 3rem; color: var(--ink-soft); font-size: 0.92rem; }

  /* ── Motion: only for people who have not asked for less of it ── */
  @media (prefers-reduced-motion: no-preference) {
    .sun::before { animation: spin 60s linear infinite; }
    .c1 { animation: drift 70s linear infinite; }
    .c2 { animation: drift 95s linear -30s infinite; }
    .c3 { animation: drift 120s linear -70s infinite; }
    .xp i { animation: fill 1.6s var(--ease) 0.4s both; }
    .hud-status i { animation: blink 1.4s steps(2) infinite; }
    h1 span { animation: pop 0.7s cubic-bezier(0.2, 1.5, 0.4, 1) both; }
    h1 span:nth-child(2) { animation-delay: 0.12s; }
    .eyebrow, .lede, .proof, .cta { animation: rise 0.6s var(--ease) both; }
    .lede { animation-delay: 0.25s; } .proof { animation-delay: 0.35s; } .intro .cta { animation-delay: 0.45s; }
    .links path { animation: draw 1.4s var(--ease) 0.5s both; }
    .links .open { animation: march 1.2s linear infinite; }
    .node { animation: twinkle 3.2s ease-in-out infinite; }
    .n1 { animation-delay: -0.6s; } .n2 { animation-delay: -1.1s; } .n3 { animation-delay: -1.7s; } .n4 { animation-delay: -2.2s; } .n5 { animation-delay: -2.7s; } .n6 { animation-delay: -1.4s; }

    /* The crab: a 16-second routine. Walk right, stop and wave, walk back, hop. Stepped timing = drawn "on twos". */
    .walker { animation: walk 16s linear infinite; }
    .crab-all { animation: bob 0.5s steps(4) infinite; }
    .crab-hop { animation: hop 16s linear infinite; }
    .crab-shadow { animation: shadow 16s linear infinite; }
    .legs-l { animation: stepl 0.5s steps(2) infinite; }
    .legs-r { animation: stepr 0.5s steps(2) infinite; }
    .arm-l { animation: wave 16s steps(1) infinite; }
    .arm-r { animation: sway 1.6s steps(6) infinite; }
    .arm-r .claw-top { animation: snap 1.6s steps(2) infinite; }
    .arm-l .claw-top { animation: snap 2.3s steps(2) -0.7s infinite; }
    .eye { animation: blinkeye 4.2s steps(1) infinite; }
    .look { animation: look 16s steps(1) infinite; }
    .bubble span { animation: say 16s steps(1) infinite; opacity: 0; }
    .bubble span:nth-child(2) { animation-name: say2; }
    .bubble span:nth-child(3) { animation-name: say3; }
    .crab:hover .crab-all { animation: hoverhop 0.75s cubic-bezier(0.3, 0, 0.4, 1) infinite; }
    .crab:hover .arm-l { animation: cheer 0.25s steps(2) infinite; }
    .crab:hover .arm-r { animation: cheer 0.25s steps(2) -0.12s infinite; }
    .slot.out { animation: glow 2.4s ease-in-out infinite; }
    .bench .grid .slot { animation: feed 2.4s steps(1) infinite; }
    .bench .grid .slot:nth-child(2) { animation-delay: 0.3s; } .bench .grid .slot:nth-child(3) { animation-delay: 0.6s; } .bench .grid .slot:nth-child(4) { animation-delay: 0.9s; }
    .arrow { animation: nudge 1.2s steps(2) infinite; }
    .sign { animation: signbob 1.8s steps(2) infinite; }
    .achievements li { animation: toast 0.5s var(--ease) both; }
