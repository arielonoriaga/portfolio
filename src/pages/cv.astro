---
// One-page recruiter-grade CV, built from src/data/profile.ts.
// Print-first: /ariel-onoriaga-cv.pdf is rendered from this page by scripts/make-assets.sh.
import { email, site, person, summary, mainQuest, workspaceSplit, crafting, experience, openSource, skills } from '../data/profile';
const highlights = [mainQuest, workspaceSplit, crafting];
const cvExperience = experience.filter((e) => !e.role.startsWith('Freelance'));
const title = `${person.name} — CV`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={`CV of ${person.name}: ${person.role}.`} />
    <link rel="canonical" href={`${site}/cv/`} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={`CV of ${person.name}: ${person.role}.`} />
    <meta property="og:image" content={`${site}/og/cv.png`} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body>
    <p class="screen-only"><a href="/">← Back to the site</a> · <a href="/ariel-onoriaga-cv.pdf">Download as PDF</a></p>
    <main>
      <header>
        <h1>{person.name}</h1>
        <p class="role">{person.role}</p>
        <p class="contact">
          <span>{person.location}</span>
          <span>{person.availability}</span>
          <span><a href={`mailto:${email}`}>{email}</a></span>
          <span><a href={site}>arielonoriaga.huggian.com</a></span>
          <span><a href={person.github}>github.com/arielonoriaga</a></span>
          <span><a href={person.linkedin}>linkedin.com/in/arielonoriaga</a></span>
        </p>
      </header>

      <section>
        <h2>Summary</h2>
        <p>{summary}</p>
      </section>

      <section>
        <h2>Experience</h2>
        {cvExperience.map((e) => (
          <article>
            <h3>{e.role} <span>{e.when}</span></h3>
            <ul>{e.points.map((p) => <li>{p}</li>)}</ul>
          </article>
        ))}
      </section>

      <section>
        <h2>Selected Systems &amp; Architecture</h2>
        {highlights.map((w) => (
          <article>
            <h3>{w.title} <span>{w.stack.join(' · ')}</span></h3>
            <p>{w.summary}</p>
          </article>
        ))}
      </section>

      <section>
        <h2>Open Source Projects</h2>
        <ul class="tight">
          {openSource.map((o) => (
            <li><strong><a href={o.href}>{o.name}</a></strong> <span class="lang">({o.lang})</span> — {o.what}</li>
          ))}
        </ul>
      </section>

      <section>
        <h2>Technical Skills</h2>
        <div class="skills">
          {skills.map(([k, v]) => (
            <p><strong>{k}:</strong> {v}</p>
          ))}
        </div>
      </section>

      <section>
        <h2>Education &amp; Languages</h2>
        <p>Self-taught Software Engineer — continuous systems &amp; AI engineering study; promoted from trainee to Engineering Lead of 7 in under two years. <strong>Languages:</strong> English (Full Professional Proficiency — 4+ years daily work with US teams), Spanish (Native).</p>
      </section>
    </main>
  </body>
</html>

<style is:global>
  @page { size: letter; margin: 7.5mm 11mm; }
  *, *::before, *::after { box-sizing: border-box; }
  body { margin: 0; color: #1a2232; background: #f5f8fc; font: 400 8.2pt/1.25 'Figtree', -apple-system, 'Segoe UI', sans-serif; }
  main { max-width: 192mm; margin: 0 auto 3rem; background: #fff; padding: 9mm 11mm; border: 1px solid #cbd5e1; }
  .screen-only { max-width: 192mm; margin: 1.2rem auto 0.8rem; padding: 0 0.3rem; }
  a { color: #0f4c9a; text-decoration: none; }
  header { padding-bottom: 5pt; margin-bottom: 5pt; border-bottom: 1.6pt solid #1a2232; }
  h1 { font: 800 18pt/1.05 'Figtree', sans-serif; letter-spacing: -0.025em; margin: 0 0 1.5pt; color: #0f172a; }
  .role { font: 600 9.6pt/1.2 'Figtree', sans-serif; margin: 0 0 3pt; color: #b83b0a; }
  .contact { margin: 0; color: #475569; font-size: 7.8pt; display: flex; flex-wrap: wrap; gap: 1pt 6pt; }
  .contact span::after { content: '·'; margin-left: 6pt; color: #94a3b8; }
  .contact span:last-child::after { content: ''; margin: 0; }
  h2 { font: 700 7.9pt/1 'Figtree', sans-serif; letter-spacing: 0.12em; text-transform: uppercase; margin: 6pt 0 2.8pt; padding-bottom: 1.8pt; border-bottom: 1pt solid #cbd5e1; color: #0f172a; }
  h3 { font: 700 8.6pt/1.2 'Figtree', sans-serif; margin: 3.5pt 0 1pt; display: flex; justify-content: space-between; gap: 10pt; align-items: baseline; color: #0f172a; }
  h3 span { font-weight: 500; font-size: 8.1pt; color: #475569; text-align: right; flex: none; }
  p { margin: 0 0 2pt; }
  ul { margin: 1.5pt 0 0; padding-left: 12pt; }
  li { margin-bottom: 1.2pt; }
  .lang { color: #64748b; font-size: 8.1pt; }
  .skills p { margin: 0 0 1.5pt; }
  .skills strong { color: #0f172a; }
  article { break-inside: avoid; }
  @media print {
    body { background: #fff; }
    main { border: 0; padding: 0; margin: 0; max-width: none; }
    .screen-only { display: none; }
  }
</style>
