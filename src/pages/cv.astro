---
// One-page CV, built from the same data as the home page. Print-first: the PDF at
// /ariel-onoriaga-cv.pdf is this page printed by scripts/make-assets.sh.
import { email, site, person, summary, mainQuest, crafting, sideQuests, experience, openSource, hotbar, skills } from '../data/profile';
const projects = [mainQuest, crafting, ...sideQuests];
const title = `${person.name} — CV`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={`CV of ${person.name}: ${person.role}.`} />
    <link rel="canonical" href={`${site}/cv/`} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={`CV of ${person.name}: ${person.role}.`} />
    <meta property="og:image" content={`${site}/og/cv.png`} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;700&family=Syne:wght@700;800&display=swap" rel="stylesheet" />
  </head>
  <body>
    <p class="screen-only"><a href="/">← Back to the site</a> · <a href="/ariel-onoriaga-cv.pdf">Download as PDF</a></p>
    <main>
      <header>
        <h1>{person.name}</h1>
        <p class="role">{person.role}</p>
        <p class="contact">
          <a href={`mailto:${email}`}>{email}</a> · <a href={site}>arielonoriaga.huggian.com</a> ·
          <a href={person.github}>github.com/arielonoriaga</a> · <a href={person.linkedin}>linkedin.com/in/arielonoriaga</a>
        </p>
        <p class="contact">{person.location} · {person.availability}</p>
      </header>

      <section>
        <h2>Summary</h2>
        <p>{summary}</p>
      </section>

      <section>
        <h2>Experience</h2>
        {experience.map((e) => (
          <article>
            <h3>{e.role} <span>{e.when}</span></h3>
            <ul>{e.points.map((p) => <li>{p}</li>)}</ul>
          </article>
        ))}
      </section>

      <section>
        <h2>Selected work</h2>
        {projects.map((w) => (
          <article>
            <h3>{w.title} <span>{w.stack.join(' · ')}</span></h3>
            <p>{w.summary}</p>
          </article>
        ))}
      </section>

      <section>
        <h2>Open source</h2>
        <ul class="tight">
          {openSource.map((o) => <li><a href={o.href}>{o.name}</a> ({o.lang}): {o.what}</li>)}
        </ul>
      </section>

      <section>
        <h2>Skills</h2>
        <p><strong>Core:</strong> {hotbar.join(', ').replace('Postgres', 'PostgreSQL')}</p>
        {skills.map(([k, v]) => <p><strong>{k}:</strong> {v}</p>)}
      </section>
    </main>
  </body>
</html>

<style is:global>
  @page { size: letter; margin: 9mm 12mm; }
  *, *::before, *::after { box-sizing: border-box; }
  body { margin: 0; color: #16233b; background: #f5f8fc; font: 400 9pt/1.32 'Figtree', -apple-system, 'Segoe UI', 'Helvetica Neue', Arial, sans-serif; }
  main { max-width: 190mm; margin: 0 auto 3rem; background: #fff; padding: 12mm 13mm; border: 1px solid #c9d6e6; }
  .screen-only { max-width: 190mm; margin: 1.2rem auto 0.8rem; padding: 0 0.3rem; }
  a { color: #0b4f9e; text-decoration: none; }
  h1 { font: 800 22pt/1 'Syne', 'Segoe UI', sans-serif; letter-spacing: -0.02em; margin: 0 0 3pt; }
  .role { font: 700 12pt/1.25 'Syne', 'Segoe UI', sans-serif; margin: 0 0 5pt; color: #0b4f9e; }
  .contact { margin: 0; color: #42526b; font-size: 9.3pt; }
  h2 { font: 800 9.5pt/1 'Syne', 'Segoe UI', sans-serif; letter-spacing: 0.14em; text-transform: uppercase; margin: 9pt 0 4pt; padding-bottom: 3pt; border-bottom: 1.5pt solid #16233b; }
  h3 { font: 700 9.8pt/1.3 'Figtree', sans-serif; margin: 5pt 0 1pt; display: flex; justify-content: space-between; gap: 10pt; align-items: baseline; }
  h3 span { font-weight: 400; font-size: 9pt; color: #42526b; text-align: right; flex: none; max-width: 55%; }
  p { margin: 0 0 2pt; }
  ul { margin: 0 0 2pt; padding-left: 12pt; }
  li { margin-bottom: 0.5pt; }
  article { break-inside: avoid; }
  @media print {
    body { background: #fff; }
    main { border: 0; padding: 0; margin: 0; max-width: none; }
    .screen-only { display: none; }
  }
</style>
